#!/usr/bin/env python3
"""Launch EAF through calibre-debug while preserving EAF dependencies."""

import json
import os
import shutil
import site
import sys


def find_calibre_debug():
    """Return calibre-debug from PATH or a standard calibre installation."""
    candidates = (
        shutil.which("calibre-debug"),
        "/Applications/calibre.app/Contents/MacOS/calibre-debug",
        os.path.expanduser(
            "~/Applications/calibre.app/Contents/MacOS/calibre-debug"
        ),
    )
    for candidate in candidates:
        if (
            candidate
            and os.path.isfile(candidate)
            and os.access(candidate, os.X_OK)
        ):
            return candidate
    raise SystemExit(
        "calibre-debug was not found. Install calibre and ensure "
        "calibre-debug is available in PATH."
    )


def main():
    app_dir = os.path.dirname(os.path.abspath(__file__))
    calibre_debug = find_calibre_debug()

    environment = os.environ.copy()
    dependency_paths = list(sys.path)
    user_site = site.getusersitepackages()
    if user_site not in dependency_paths:
        dependency_paths.append(user_site)
    environment["EAF_SYSTEM_PYTHON_PATHS"] = json.dumps(dependency_paths)

    bootstrap = os.path.join(app_dir, "eaf_calibre_bootstrap.py")
    argv = [calibre_debug, "-e", bootstrap, "--", *sys.argv[1:]]
    os.execve(calibre_debug, argv, environment)


if __name__ == "__main__":
    main()
